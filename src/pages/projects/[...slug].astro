---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { projectGroups } from '../../data/site';
import { getProjects, hasBody, type ProjectEntry } from '../../lib/content';

// Only projects with a written body get a case-study page.
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter(hasBody).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { title, summary, group, repo, demo, paper, stack } = project.data;
const { Content } = await render(project);
---

<Article
  title={title}
  description={summary}
  kicker={`Case study · ${projectGroups[group].label}`}
  back={{ label: 'All projects', href: '/projects/' }}
>
  <Fragment slot="meta">
    {stack.length > 0 && <p class="label">{stack.join(' · ')}</p>}
    {repo && <a class="label link" href={`https://github.com/${repo}`} rel="noopener">Code ↗</a>}
    {demo && <a class="label link" href={demo} rel="noopener">Demo ↗</a>}
    {paper && <a class="label link" href={paper} rel="noopener">Paper ↗</a>}
  </Fragment>
  <Content />
</Article>
