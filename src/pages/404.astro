---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="max-w-[70ch] pt-16">
    <p class="label">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">This page does not exist.</h1>
    <p class="mt-4 text-xl">
      It may have moved when the site was rebuilt. Try the <a class="link" href="/">home page</a> or
      the <a class="link" href="/projects/">projects</a>.
    </p>
  </div>
</Base>
