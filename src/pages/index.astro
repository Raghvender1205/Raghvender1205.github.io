---
import Base from '../layouts/Base.astro';
import NetworkNav from '../components/NetworkNav.astro';
import { profile } from '../data/site';
---

<Base wide>
  <section class="max-w-3xl pt-12 sm:pt-16">
    <p class="label">{profile.role} · {profile.company} · {profile.location}</p>
    <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
      I build machine learning systems, from the model down to the database.
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{profile.intro[0]}</p>
  </section>

  <section class="mt-10">
    <NetworkNav />
  </section>
</Base>
