---
// The portfolio drawn as a small neural network. Each layer holds the children of the node
// selected in the layer before it, and the "output" panel shows the selected node.
import { icon } from '../lib/icons';
import { buildNetwork, iconNames, type NetNode } from '../lib/network';

const network = await buildNetwork();
const icons = Object.fromEntries(
  [...iconNames(network), 'caret-right', 'arrow-right', 'arrow-up-right'].map((name) => [name, icon(name)]),
);
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<section class="net" aria-label="Portfolio network">
  <div class="net-stage" data-net-stage>
    <div class="net-canvas" data-net-canvas>
      <svg class="net-edges" data-net-edges aria-hidden="true"></svg>
    </div>
  </div>
  <article class="net-output" data-net-output aria-live="polite"></article>

  <noscript>
    <ul class="net-fallback">
      {
        network.children?.map((node: NetNode) => (
          <li>
            {node.label}
            <ul>
              {node.links?.map((link) => <li><a class="link" href={link.href}>{link.label}</a></li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </noscript>

  <script type="application/json" data-net-data set:html={json(network)} />
  <script type="application/json" data-net-icons set:html={json(icons)} />
</section>

<script>
  interface NetLink {
    label: string;
    href: string;
  }

  interface NetNode {
    id: string;
    label: string;
    icon: string;
    color?: string;
    title: string;
    meta?: string;
    text?: string[];
    facts?: { term: string; detail: string }[];
    list?: string[];
    links?: NetLink[];
    children?: NetNode[];
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const read = (selector: string) => JSON.parse(document.querySelector(selector)!.textContent!);

  const root: NetNode = read('[data-net-data]');
  const icons: Record<string, string> = read('[data-net-icons]');
  const stage = document.querySelector<HTMLElement>('[data-net-stage]')!;
  const canvas = document.querySelector<HTMLElement>('[data-net-canvas]')!;
  const edges = document.querySelector<SVGSVGElement>('[data-net-edges]')!;
  const output = document.querySelector<HTMLElement>('[data-net-output]')!;

  // The selected node in each layer, starting with the input node.
  let path: NetNode[] = [root];

  const hasChildren = (node: NetNode) => Boolean(node.children?.length);

  // Top-level branches carry a category colour, and everything beneath one inherits it.
  const colorVar = (node: NetNode | undefined) => (node?.color ? `var(--cat-${node.color})` : '');

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function iconEl(name: string, className: string) {
    const span = el('span', className);
    span.innerHTML = icons[name] ?? '';
    return span;
  }

  function pathFromHash(): NetNode[] {
    const ids = decodeURIComponent(location.hash.replace(/^#\/?/, '')).split('/').filter(Boolean);
    const found = [root];
    for (const id of ids) {
      const next = found[found.length - 1].children?.find((child) => child.id === id);
      if (!next) break;
      found.push(next);
    }
    return found;
  }

  function renderLayers(newLayer: boolean) {
    canvas.querySelectorAll('.net-col').forEach((col) => col.remove());

    const layers: NetNode[][] = [[root]];
    for (const node of path) if (hasChildren(node)) layers.push(node.children!);

    layers.forEach((nodes, depth) => {
      const col = el('div', 'net-col');
      if (newLayer && depth === layers.length - 1 && depth > 0) col.dataset.new = '';
      col.append(el('p', 'net-col-head label', depth === 0 ? 'Input' : `Layer ${depth}`));

      const list = el('ul', 'net-nodes');
      for (const node of nodes) {
        const selected = path[depth] === node;
        const button = el('button', 'net-node');
        button.type = 'button';
        button.dataset.depth = String(depth);
        button.dataset.id = node.id;
        const color = colorVar(depth === 1 ? node : path[1]);
        if (color && depth > 0) button.style.setProperty('--node-color', color);
        if (selected) button.setAttribute('aria-current', 'true');
        if (hasChildren(node)) button.setAttribute('aria-expanded', String(selected));
        button.append(iconEl(node.icon, 'net-node-icon'), el('span', 'net-node-label', node.label));
        if (hasChildren(node)) button.append(iconEl('caret-right', 'net-node-more'));
        button.addEventListener('click', () => select(depth, node));

        const item = el('li');
        item.append(button);
        list.append(item);
      }
      col.append(list);
      canvas.append(col);
    });
  }

  function renderOutput() {
    const node = path[path.length - 1];
    output.replaceChildren();
    output.style.setProperty('--node-color', colorVar(path[1]) || 'var(--muted)');

    output.append(el('p', 'label net-output-kicker', `Output · ${path.map((step) => step.label).join(' / ')}`));
    output.append(el('h2', 'net-output-title', node.title));
    if (node.meta) output.append(el('p', 'net-output-meta', node.meta));
    for (const paragraph of node.text ?? []) output.append(el('p', 'net-output-text', paragraph));

    if (node.facts?.length) {
      const facts = el('dl', 'net-output-facts');
      for (const fact of node.facts) {
        const row = el('div');
        row.append(el('dt', 'label', fact.term), el('dd', undefined, fact.detail));
        facts.append(row);
      }
      output.append(facts);
    }

    if (node.list?.length) {
      const list = el('ul', 'net-output-list');
      for (const item of node.list) list.append(el('li', undefined, item));
      output.append(list);
    }

    if (node.links?.length) {
      const links = el('ul', 'net-output-links');
      for (const link of node.links) {
        const external = /^(https?:|mailto:)/.test(link.href);
        const anchor = el('a', 'link');
        anchor.href = link.href;
        if (external) anchor.rel = 'noopener';
        anchor.append(el('span', undefined, link.label), iconEl(external ? 'arrow-up-right' : 'arrow-right', 'net-link-icon'));
        const item = el('li');
        item.append(anchor);
        links.append(item);
      }
      output.append(links);
    }

    if (hasChildren(node)) {
      const count = node.children!.length;
      output.append(el('p', 'net-output-hint', `${count} ${count === 1 ? 'node' : 'nodes'} in the next layer.`));
    }
  }

  // Every node connects to every node in the next layer, as in a dense layer.
  // Connections leaving the selected node are stronger, and the chosen route is coloured.
  function drawEdges() {
    edges.replaceChildren();
    const origin = canvas.getBoundingClientRect();
    const cols = [...canvas.querySelectorAll<HTMLElement>('.net-col')];
    const strong: SVGLineElement[] = [];

    for (let depth = 0; depth < cols.length - 1; depth++) {
      const sources = cols[depth].querySelectorAll<HTMLElement>('.net-node');
      const targets = cols[depth + 1].querySelectorAll<HTMLElement>('.net-node');
      for (const source of sources) {
        const from = source.getBoundingClientRect();
        const fromSelected = source.hasAttribute('aria-current');
        for (const target of targets) {
          const to = target.getBoundingClientRect();
          const line = document.createElementNS(SVG_NS, 'line');
          line.setAttribute('x1', String(from.right - origin.left));
          line.setAttribute('y1', String(from.top + from.height / 2 - origin.top));
          line.setAttribute('x2', String(to.left - origin.left));
          line.setAttribute('y2', String(to.top + to.height / 2 - origin.top));
          line.setAttribute('class', 'net-edge');
          if (fromSelected) {
            line.classList.add(target.hasAttribute('aria-current') ? 'is-path' : 'is-fan');
            strong.push(line);
          } else {
            edges.append(line);
          }
        }
      }
    }
    // Drawn last so they sit on top of the faint connections.
    strong.sort((a, b) => Number(a.classList.contains('is-path')) - Number(b.classList.contains('is-path')));
    edges.append(...strong);
  }

  function render(newLayer = false) {
    canvas.style.setProperty('--path-color', colorVar(path[1]) || 'var(--accent)');
    renderLayers(newLayer);
    renderOutput();
    drawEdges();
  }

  function focusNode(depth: number, id: string) {
    canvas.querySelector<HTMLElement>(`.net-node[data-depth="${depth}"][data-id="${CSS.escape(id)}"]`)?.focus();
  }

  function select(depth: number, node: NetNode) {
    path = [...path.slice(0, depth), node];
    const hash = path.slice(1).map((step) => step.id).join('/');
    history.replaceState(null, '', hash ? `#/${hash}` : location.pathname + location.search);
    render(hasChildren(node));
    focusNode(depth, node.id);
    // On narrow screens, bring the newest layer into view.
    stage.scrollTo({ left: stage.scrollWidth, behavior: 'smooth' });
  }

  // Arrow keys: up and down within a layer, right into the next layer, left back to the previous one.
  canvas.addEventListener('keydown', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('.net-node');
    if (!button) return;
    const depth = Number(button.dataset.depth);
    const column = [...button.closest('.net-col')!.querySelectorAll<HTMLElement>('.net-node')];
    const index = column.indexOf(button);

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      column[(index + step + column.length) % column.length].focus();
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      if (!button.hasAttribute('aria-current')) button.click();
      const next = path[depth]?.children?.[0];
      if (next) focusNode(depth + 1, path[depth + 1]?.id ?? next.id);
    } else if (event.key === 'ArrowLeft' && depth > 0) {
      event.preventDefault();
      focusNode(depth - 1, path[depth - 1].id);
    }
  });

  window.addEventListener('hashchange', () => {
    path = pathFromHash();
    render();
  });
  new ResizeObserver(drawEdges).observe(canvas);
  document.fonts?.ready.then(drawEdges);

  path = pathFromHash();
  render();
</script>

<style is:global>
  .net {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 64rem) {
    .net {
      grid-template-columns: minmax(0, 1fr) 21rem;
    }

    .net-output {
      position: sticky;
      top: 1.5rem;
    }
  }

  .net-stage {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background-color: var(--surface);
    background-image: radial-gradient(var(--rule) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .net-canvas {
    position: relative;
    display: flex;
    gap: 4.5rem;
    width: max-content;
    min-width: 100%;
    min-height: 27rem;
    padding: 1.25rem 1.5rem 1.75rem;
  }

  .net-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .net-edge {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .net-edge.is-fan {
    stroke: var(--muted);
    opacity: 0.6;
  }

  .net-edge.is-path {
    stroke: var(--path-color, var(--accent));
    stroke-width: 1.5;
  }

  .net-col {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    width: 11.5rem;
  }

  .net-col[data-new] {
    animation: net-in 200ms ease-out;
  }

  @keyframes net-in {
    from {
      opacity: 0;
    }
  }

  .net-col-head {
    margin-bottom: 0.75rem;
  }

  .net-nodes {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .net-node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 150ms,
      background-color 150ms,
      color 150ms;
  }

  .net-node:hover {
    border-color: var(--muted);
  }

  /* Selected: a light tint of the branch colour (grey for the input node). */
  .net-node[aria-current='true'] {
    border-color: var(--node-color, var(--muted));
    background: color-mix(in srgb, var(--node-color, var(--muted)) 10%, var(--surface));
    font-weight: 500;
  }

  .net-node-icon,
  .net-node-more,
  .net-link-icon {
    display: inline-flex;
    flex: none;
  }

  .net-node-icon {
    color: var(--node-color, currentColor);
  }

  .net-node-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .net-node-more {
    margin-left: auto;
    opacity: 0.55;
  }

  .net-node-more svg,
  .net-link-icon svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .net-output {
    min-height: 27rem;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--surface);
  }

  /* Square chip in the branch colour, as a category marker. */
  .net-output-kicker::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 2px;
    background: var(--node-color);
  }

  .net-output-title {
    margin-top: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .net-output-meta {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .net-output-text {
    margin-top: 0.75rem;
  }

  .net-output-facts {
    margin-top: 1rem;
  }

  .net-output-facts > div {
    padding-block: 0.625rem;
    border-top: 1px solid var(--rule);
  }

  .net-output-facts dd {
    line-height: 1.35;
  }

  .net-output-list {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .net-output-list li {
    margin-top: 0.4rem;
    line-height: 1.45;
  }

  .net-output-list li::marker {
    color: var(--muted);
  }

  .net-output-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .net-output-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-block: 0.375rem;
    font-weight: 500;
  }

  .net-output-hint {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .net-fallback {
    padding: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .net-col[data-new] {
      animation: none;
    }
  }
</style>
