---
import { profile } from '../data/site';
---

<footer class="mx-auto w-full max-w-5xl px-5 pb-10 sm:px-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-t border-ink pt-4">
    <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {
        profile.links.map((link) => (
          <li>
            <a class="label inline-block py-2 transition-colors duration-200 hover:text-accent" href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="label inline-block py-2 transition-colors duration-200 hover:text-accent" href="/rss.xml">RSS</a>
      </li>
    </ul>
  </div>
</footer>
