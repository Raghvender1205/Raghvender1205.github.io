---
interface Props {
  number?: string;
  title: string;
  more?: { label: string; href: string };
}

const { number, title, more } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-rule pb-3">
  <h2 class="text-2xl font-semibold tracking-tight">
    {number && <span class="label mr-3 align-middle">§ {number}</span>}
    {title}
  </h2>
  {more && <a class="label link" href={more.href}>{more.label} →</a>}
</div>
